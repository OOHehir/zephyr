/* SPI2 M1 on J13: wire MOSI (pin 19) to MISO (pin 21) */
&spi2 {
	slow@0 {
		compatible = "test-spi-loopback-slow";
		reg = <0>;
		spi-max-frequency = <500000>;
	};

	fast@0 {
		compatible = "test-spi-loopback-fast";
		reg = <0>;
		spi-max-frequency = <12000000>;
	};
};

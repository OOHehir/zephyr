config ROCKCHIP_TSADC
	bool "Rockchip TSADC temperature sensor"
	default y
	depends on DT_HAS_ROCKCHIP_RK3568_TSADC_ENABLED
	select RESET
	help
	  Enable the Rockchip RK3568 TSADC, which measures the SoC temperature
	  at the CPU & GPU.

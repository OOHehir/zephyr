config GPIO_ROCKCHIP
	bool "Rockchip GPIO driver"
	default y
	depends on DT_HAS_ROCKCHIP_GPIO_BANK_ENABLED
	select PINCTRL if $(dt_compat_any_has_prop,$(DT_COMPAT_ROCKCHIP_GPIO_BANK),pinctrl-0)
	help
	  Enable the driver for the Rockchip GPIO controller (version 2),
	  found on RK356x and RK3588 SoCs.
